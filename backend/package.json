{
  "name": "gobingo-backend",
  "version": "1.0.0",
  "description": "GOBINGO real-time multiplayer 75-ball Ethiopian Bingo backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node ../scripts/ensurePostgres.js && nodemon src/index.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "test": "node ../scripts/ensurePostgres.js && jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "redis": "^6.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
